{
  "name": "nandacity",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --import tsx --test test/identity/anvil.test.ts test/identity/profile.test.ts test/identity/registry.test.ts test/identity/verify.test.ts test/discovery/cardFetch.test.ts test/discovery/cli.test.ts test/discovery/indexClient.test.ts test/discovery/indexProcesses.test.ts test/discovery/externalClientTransport.test.ts test/discovery/ownedProxy.test.ts test/discovery/verifyDiscovery.test.ts test/interaction/schema.test.ts test/interaction/signatures.test.ts test/interaction/verify.test.ts test/feedback/feedback.test.ts test/feedback/document.test.ts test/a2a/answer.test.ts test/a2a/runtime.test.ts test/report/staticReport.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/identity/registry.integration.test.ts test/identity/continuity.integration.test.ts test/a2a/authority.integration.test.ts test/feedback/publication.integration.test.ts test/feedback/publicationRead.integration.test.ts test/discovery/twoIndexes.integration.test.ts test/discovery/chicagoJourney.integration.test.ts test/discovery/sixServiceFixture.integration.test.ts test/discovery/externalClient.integration.test.ts test/discovery/externalClientSignal.integration.test.ts test/report/reportSignal.integration.test.ts",
    "test:feedback": "node --import tsx --test test/feedback/feedback.test.ts test/feedback/document.test.ts test/feedback/publication.integration.test.ts test/feedback/publicationRead.integration.test.ts",
    "contracts:check": "node --import tsx scripts/check-reference-contracts.ts",
    "demo:identity": "node --import tsx src/cli.ts identity demo",
    "demo:discovery": "node --import tsx src/cli.ts discovery demo",
    "demo:journey": "node --import tsx src/cli.ts journey demo",
    "demo:compare": "node --import tsx src/cli.ts compare demo",
    "demo:report": "node --import tsx src/cli.ts report demo",
    "demo:external-client": "node --import tsx src/cli.ts external-client demo",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build && npm run test:integration"
  },
  "dependencies": {
    "viem": "2.56.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0",
    "@types/node": "24.13.5",
    "solc": "0.8.24",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
